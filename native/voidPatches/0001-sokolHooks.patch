From 12e44e707aedc724f0c29b8c0e389d09593d64c0 Mon Sep 17 00:00:00 2001
From: trongphuc <trongphucgiga@gmail.com>
Date: Sat, 3 Oct 2026 01:40:44 +0700
Subject: [PATCH 1/2] feat(sokol): larger buffer, image and view pools, and a
 2D pass that draws over the 3D frame

---
 src/sokol/bridge.c        | 11 ++++++++++-
 src/sokol/bridge.h        |  2 ++
 src/sokol/bridgeAndroid.c |  6 ++++++
 src/sokol/gpu.ms          |  5 +++++
 4 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/sokol/bridge.c b/src/sokol/bridge.c
index 4279218..bfed8dc 100644
--- a/src/sokol/bridge.c
+++ b/src/sokol/bridge.c
@@ -130,9 +130,17 @@ int voidIsRenderTargetView(uint32_t view) {
 
 // --- Frame sequence ---
 
+// A HUD drawn over a 3D frame: the 3D renderer commits on its own, so the frame skips that
+// one commit, and the 2D pass that follows keeps the 3D image instead of clearing it.
+static int s_skipNextCommit = 0;
+static int s_loadNextPass = 0;
+void voidSkipNextCommit(void) { s_skipNextCommit = 1; }
+void voidLoadNextPass(void) { s_loadNextPass = 1; }
+
 void voidBeginPass(float r, float g, float b, float a) {
 	sg_pass pass = {0};
-	pass.action.colors[0].load_action = SG_LOADACTION_CLEAR;
+	pass.action.colors[0].load_action = s_loadNextPass ? SG_LOADACTION_LOAD : SG_LOADACTION_CLEAR;
+	s_loadNextPass = 0;
 	pass.action.colors[0].clear_value = (sg_color){r, g, b, a};
 	pass.action.depth.load_action = SG_LOADACTION_CLEAR;
 	pass.action.depth.clear_value = 1.0f;
@@ -163,6 +171,7 @@ void voidEndPass(void) { sg_end_pass(); }
 static void (*s_commitHook)(void);
 void voidSetCommitHook(void (*fn)(void)) { s_commitHook = fn; }
 void voidCommit(void) {
+	if (s_skipNextCommit) { s_skipNextCommit = 0; return; }
 	sg_commit();
 	if (s_commitHook) { s_commitHook(); }
 	voidDriverPresent();
diff --git a/src/sokol/bridge.h b/src/sokol/bridge.h
index 4049932..4d99374 100644
--- a/src/sokol/bridge.h
+++ b/src/sokol/bridge.h
@@ -73,5 +73,7 @@ void voidDraw(int count);
 void voidEndPass(void);
 void voidCommit(void);
 void voidSetCommitHook(void (*fn)(void));
+void voidSkipNextCommit(void);
+void voidLoadNextPass(void);
 
 #endif
diff --git a/src/sokol/bridgeAndroid.c b/src/sokol/bridgeAndroid.c
index 1e86868..1d19a9e 100644
--- a/src/sokol/bridgeAndroid.c
+++ b/src/sokol/bridgeAndroid.c
@@ -57,6 +57,12 @@ static void sokolSetup(void) {
 	d.environment.defaults.depth_format = SG_PIXELFORMAT_NONE;
 	d.environment.defaults.sample_count = 1;
 	d.logger.func = slog_func;
+	// A mesh is two buffers, and a glTF scene is one mesh per node: hibernal's hills, pillars,
+	// logs and walker are 64 meshes, which alone fill sokol's default pool of 128.
+	d.buffer_pool_size = 1024;
+	// the UI kit makes a texture per frame size + seed + look and one per icon
+	d.image_pool_size = 1024;
+	d.view_pool_size = 1024;
 	sg_setup(&d);
 	if (!sg_isvalid()) voidFail("sg_setup on the EGL context failed");
 }
diff --git a/src/sokol/gpu.ms b/src/sokol/gpu.ms
index c3d9e12..ec511a9 100644
--- a/src/sokol/gpu.ms
+++ b/src/sokol/gpu.ms
@@ -85,6 +85,8 @@ extern function voidApplyMvp(mvp: Ptr<void>): void;
 extern function voidDraw(count: int32): void;
 extern function voidEndPass(): void;
 extern function voidCommit(): void;
+extern function voidSkipNextCommit(): void;
+extern function voidLoadNextPass(): void;
 extern function voidMakeRenderTarget(w: int32, h: int32): uint32;
 extern function voidRenderTargetView(rt: uint32): uint32;
 extern function voidBeginRenderTargetPass(rt: uint32, r: float32, g: float32, b: float32, a: float32): void;
@@ -109,6 +111,9 @@ export function applyMvp(mvp: Ptr<void>): void { voidApplyMvp(mvp); }
 export function draw(count: int32): void { voidDraw(count); }
 export function endPass(): void { voidEndPass(); }
 export function commit(): void { voidCommit(); }
+// HUD over a 3D frame: skip the 3D renderer's own commit, keep its image in the next 2D pass.
+export function skipNextCommit(): void { voidSkipNextCommit(); }
+export function loadNextPass(): void { voidLoadNextPass(); }
 export function makeRenderTarget(w: int32, h: int32): uint32 { return voidMakeRenderTarget(w, h); }
 export function renderTargetView(rt: uint32): uint32 { return voidRenderTargetView(rt); }
 export function beginRenderTargetPass(rt: uint32, r: float32, g: float32, b: float32, a: float32): void { voidBeginRenderTargetPass(rt, r, g, b, a); }
-- 
