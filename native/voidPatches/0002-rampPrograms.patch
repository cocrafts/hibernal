+float valueNoise(vec2 p, float salt) {
+    vec2 i = floor(p);
+    vec2 f = p - i;
+    vec2 u = f * f * (3.0 - 2.0 * f);
+    float a = hash21(i, salt);
+    float b = hash21(i + vec2(1.0, 0.0), salt);
+    float c = hash21(i + vec2(0.0, 1.0), salt);
