		12 => 0x2d231f1913111213,
		13 => 0x342926201a171819,
		14 => 0x38302d28211e1f1f,
		15 => 0x403735302a272728,
		16 => 0x46403d3934313032,
		17 => 0x4d4846443f3c3c3d,
		18 => 0x5651504e4b494849,
		19 => 0x5d5b5a5957575656,
		20 => 0x6564646464646464,
		21 => 0x6b6d6e6f71727271,
		22 => 0x7477787a7e7f7f7f,
		23 => 0x7b808284898b8c8b,
		24 => 0x82888b8f94979796,
		25 => 0x889093989ea1a1a0,
		26 => 0x8f989ba0a7a9aaa9,
		27 => 0x959fa2a8aeb1b0af,
		28 => 0x9ba5a8afb5b7b6b5,
		29 => 0xa1aaaeb4b9bbbab9,
		30 => 0xa8afb4b9bdbfbebd,
		31 => 0xabb3b8bdc0c2c0c0,
		32 => 0xb0b7bcc0c3c3c2c2,
		33 => 0xb5b9bfc2c4c5c4c3,
		34 => 0xb9bcc1c4c6c6c5c4,
		35 => 0xbbbec3c5c6c7c6c6,
		36 => 0xbec0c5c6c7c7c6c6,
